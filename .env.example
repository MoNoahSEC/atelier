APP_NAME="MT Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql

# Write/primary host
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mt_commerce
DB_USERNAME=root
DB_PASSWORD=

# Read replica hosts (comma-separated; falls back to DB_HOST when empty)
DB_READ_HOST=

# Sticky connections keep reads on the write connection after a write
DB_STICKY=true

# ─── Redis ────────────────────────────────────────────────────────────────────
# Use "phpredis" for ext-redis (recommended) or "predis" for pure-PHP
REDIS_CLIENT=phpredis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_USERNAME=

# Separate logical Redis databases per concern (avoids key collisions)
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_HORIZON_DB=4

REDIS_PREFIX=mt_commerce_
REDIS_PERSISTENT=false

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=mt_commerce_cache_
REDIS_CACHE_CONNECTION=cache

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_CONNECTION=session

# ─── Queue ────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

# ─── Horizon ─────────────────────────────────────────────────────────────────
HORIZON_NAME="MT Commerce Horizon"
HORIZON_PATH=horizon
HORIZON_PREFIX=mt_commerce_horizon:
HORIZON_MEMORY_LIMIT=256

# Per-supervisor process counts (production)
HORIZON_MIN_PROCESSES_PRODUCTS=2
HORIZON_MAX_PROCESSES_PRODUCTS=10
HORIZON_MIN_PROCESSES_ORDERS=2
HORIZON_MAX_PROCESSES_ORDERS=8
HORIZON_MIN_PROCESSES_FULFILLMENT=2
HORIZON_MAX_PROCESSES_FULFILLMENT=6
HORIZON_MIN_PROCESSES_WEBHOOKS=2
HORIZON_MAX_PROCESSES_WEBHOOKS=10
HORIZON_MIN_PROCESSES_SHIPMENTS=1
HORIZON_MAX_PROCESSES_SHIPMENTS=6
HORIZON_MIN_PROCESSES_NOTIFICATIONS=1
HORIZON_MAX_PROCESSES_NOTIFICATIONS=4
HORIZON_MIN_PROCESSES_DEFAULT=1
HORIZON_MAX_PROCESSES_DEFAULT=4

# Per-queue timeouts and retries
HORIZON_TRIES_PRODUCTS=3
HORIZON_TIMEOUT_PRODUCTS=120
HORIZON_TRIES_ORDERS=3
HORIZON_TIMEOUT_ORDERS=90
HORIZON_TRIES_FULFILLMENT=3
HORIZON_TIMEOUT_FULFILLMENT=90
HORIZON_TRIES_WEBHOOKS=3
HORIZON_TIMEOUT_WEBHOOKS=60
HORIZON_TRIES_SHIPMENTS=3
HORIZON_TIMEOUT_SHIPMENTS=60
HORIZON_TRIES_NOTIFICATIONS=3
HORIZON_TIMEOUT_NOTIFICATIONS=30
HORIZON_TRIES_DEFAULT=3
HORIZON_TIMEOUT_DEFAULT=60

# ─── Automation API ───────────────────────────────────────────────────────────
# HMAC secret for signing/verifying automation webhook requests
AUTOMATION_HMAC_SECRET=

# Maximum age of a signed automation request in seconds (replay protection)
AUTOMATION_TIMESTAMP_TTL=300

AUTOMATION_SIGNATURE_HEADER=X-Automation-Signature
AUTOMATION_TIMESTAMP_HEADER=X-Automation-Timestamp

# Sanctum token abilities for automation API
AUTOMATION_READ_ABILITY=automation:read
AUTOMATION_WRITE_ABILITY=automation:write

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_AUTOMATION=120
RATE_LIMIT_WEBHOOKS=240
RATE_LIMIT_CUSTOMERS=60
RATE_LIMIT_PUBLIC=30

# ─── Pagination ───────────────────────────────────────────────────────────────
AUTOMATION_PENDING_ORDERS_PER_PAGE=100
AUTOMATION_MAX_PER_PAGE=500

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS (optional) ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# Payment Configuration
PAYMENT_DEFAULT_CURRENCY=EGP
PAYMENT_ENABLED_METHODS=stripe,paymob,cod

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Paymob (Egypt)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
PAYMOB_BASE_URL=https://eg.paymob.com
PAYMOB_CHECKOUT_URL=https://eg.checkout.paymob.com
PAYMOB_SANDBOX=true

# Cash on Delivery
COD_ENABLED=true
COD_MAX_AMOUNT=500000
COD_SURCHARGE=2000
