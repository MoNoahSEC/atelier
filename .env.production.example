APP_NAME=ATELIER
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://atelier404.store
APP_TIMEZONE=Africa/Cairo
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=atelier
DB_USERNAME=atelier
DB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_PASSWORD

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
SESSION_DOMAIN=.atelier404.store
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=https://atelier404.store,https://www.atelier404.store,capacitor://localhost
CORS_SUPPORTS_CREDENTIALS=true

PAYMENT_ENABLED_METHODS=paymob,cod
